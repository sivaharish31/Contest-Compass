# Database (MySQL)
DATABASE_URL=jdbc:mysql://localhost:3306/contestradar?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DATABASE_USERNAME=contestradar
DATABASE_PASSWORD=your_password_here

# Server
SERVER_PORT=8080

# Mail (development: use MailHog on port 1025, or leave defaults)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@contestradar.dev

# Session & CORS
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Contest sync interval (ms) — default 15 minutes
SYNC_INTERVAL_MS=900000

# Reminder check interval (ms) — default 1 minute
REMINDER_CHECK_INTERVAL_MS=60000
REMINDER_LEAD_MINUTES=10

# Enable mock contest data for development
MOCK_PROVIDER_ENABLED=true
